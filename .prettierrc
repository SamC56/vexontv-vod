{
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "semi": false,
    "singleQuote": false,
    "arrowParens": "always",
    "trailingComma": "all",
    "endOfLine": "lf",
    "overrides": [
        {
            "files": ["*.json"],
            "options": { "tabWidth": 2 }
        }
    ]
}
